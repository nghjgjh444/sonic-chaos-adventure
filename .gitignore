# .gitignore

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg
*.translation
*.pot
.mono/
data_*/
monodoc_json_index/

# Godot 4+ specific (ignored for Godot 3.6)
.godot/

# Misc
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/
*.user
*.pyc
__pycache__/

# Build artifacts
bin/
build/
dist/

# Save files (optional - remove if you want to commit saves)
user://
*.save
